prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: x87trans
Description: Reconstructed Skylake x87 transcendental numerical library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lx87trans
Requires.private: gmp
Cflags: -I${includedir}
